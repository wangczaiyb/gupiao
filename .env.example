# ==========================================
# A 股波段交易辅助系统 环境变量配置示例
# 复制本文件为 .env 进行本地私有配置
# 系统默认即可零配置离线/公网运行，所有密钥切勿提交 GitHub
# ==========================================

# 1. 服务运行配置
APP_HOST=0.0.0.0
APP_PORT=8501
DEBUG=false

# 2. 数据源配置
# PRIMARY_DATA_SOURCE: akshare / baostock / local
PRIMARY_DATA_SOURCE=akshare
FALLBACK_DATA_SOURCE=baostock
CACHE_DIR=./data/cache
DB_PATH=./data/stock_analysis.db

# 3. 可选 AI 增强配置 (未配置时不影响任何核心交易、筛选与回测功能)
# 支持 OpenAI / 通义千问 / DeepSeek / Gemini 等兼容 API
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
